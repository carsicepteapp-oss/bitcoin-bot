# ── Data Source ──────────────────────────────────────────────────────────────
DATA_SOURCE=binance
SYMBOL=BTCUSDT
CANDLE_INTERVAL=1m
POLLING_INTERVAL_SEC=15
BUFFER_SIZE=200
REQUEST_TIMEOUT_SEC=10

# ── Feature Engineering ───────────────────────────────────────────────────────
EMA_SHORT=5
EMA_MID=9
EMA_LONG=20
RSI_PERIOD=14
ATR_PERIOD=14
MOMENTUM_PERIOD=5
ZSCORE_LOOKBACK=20
VOLATILITY_LOOKBACK=20
VOL_SHORT_WINDOW=5
CANDLE_SEQUENCE_LOOKBACK=5

# ── Strategy ──────────────────────────────────────────────────────────────────
# Her pencerede mutlaka UP veya DOWN karar ver (NO_TRADE üretme)
ALWAYS_TRADE=false
CONFIDENCE_THRESHOLD=55.0
SIDEWAYS_CONFIDENCE_PENALTY=10.0
HIGH_VOL_CONFIDENCE_PENALTY=15.0
CHAOTIC_CONFIDENCE_PENALTY=20.0
MIN_CANDLES_REQUIRED=25

# ── Risk Management ───────────────────────────────────────────────────────────
INITIAL_BALANCE=1000.0
# stake_mode: "fixed" or "percent"
STAKE_MODE=fixed
STAKE_FIXED=10.0
STAKE_PERCENT=1.0
MAX_DAILY_LOSS=50.0
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_WINDOWS=2
LOSS_REDUCTION_FACTOR=0.5
SLIPPAGE_PCT=0.0

# ── Volatility Filters ────────────────────────────────────────────────────────
ATR_RATIO_MAX=2.5
NOISE_SCORE_MAX=0.7
VOL_RATIO_MAX=3.0

# ── Output ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports
DATA_DIR=data
